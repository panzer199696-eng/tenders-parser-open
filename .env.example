# Скопируйте в .env и при необходимости измените. Файл .env в git не попадает.
# Значения ниже переносятся в settings.json один раз — при первом запуске,
# дальше параметры правятся в окне программы («Настройки»).

# Глубина поиска по дате публикации, дней
DAYS_BACK=1
# MIN_PRICE — порог цены. Фильтр применяется ТОЛЬКО к тендерам с известной ценой;
# тендеры без цены проходят всегда. 0 — без порога.
MIN_PRICE=0

# Браузер (нужен Tender.pro и ГПБ): true — без окна
BROWSER_HEADLESS=true

# Площадки
PARSE_TENDER_PRO=true
PARSE_GPB=false
PARSE_ZAKUPKI=false
PARSE_TEKTORG=true
PARSE_ROSELTORG=true

# Прокси для браузера (необязательно): http://host:port
PROXY_SERVER=

# Порт веб-окна (по умолчанию 5000)
# PORT=5000
